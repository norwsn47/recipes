// Family Recipes: one Worker serving the SPA (static assets) and /api/*.
// No secrets here. Non-secret config only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-recipes",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },

  // Non-secret config. GOOGLE_CLIENT_ID is the ID token audience; the Worker fails closed
  // (every sign-in refused) while it is empty. Owner sets the real value (not a secret).
  // The usage-limit vars below have in-code defaults, so they stay unset until needed.
  "vars": {
    "GOOGLE_CLIENT_ID": ""
    // "MAX_TOTAL_STORAGE_BYTES": "5368709120",
    // "MAX_USER_STORAGE_BYTES": "104857600",
    // "MAX_USER_RECIPES": "50",
    // "WRITE_RATE_PER_MINUTE": "20"
  },

  // OWNER STEP: run `npx wrangler d1 create family-recipes-db` and replace the placeholder
  // database_id below with the returned id. The placeholder is not a real id (deploy will fail
  // until it is replaced); local development and tests do not need a real one.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-recipes-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]

  // OWNER STEP (later): R2 bucket, then uncomment:
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "family-recipes-files" }]
  // (no public bucket URL; files are served only through an authenticated Worker route.)
}
