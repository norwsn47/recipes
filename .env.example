# Names only, never values. Real values live in .dev.vars (local, gitignored) and the Cloudflare dashboard.
# See .dev.vars.example for the Worker-side names.

# Browser build (Vite): Google OAuth client ID for the sign-in button. Not a secret.
VITE_GOOGLE_CLIENT_ID=

# Worker: same client ID, checked as the ID token audience. Not a secret.
GOOGLE_CLIENT_ID=

# Worker usage limits (optional; in-code defaults apply if unset)
MAX_TOTAL_STORAGE_BYTES=
MAX_USER_STORAGE_BYTES=
MAX_USER_RECIPES=
WRITE_RATE_PER_MINUTE=
LINK_TITLE_RATE_PER_MINUTE=
