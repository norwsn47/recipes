// Family Recipes: one Worker serving the SPA (static assets) and /api/*.
// No secrets here. Non-secret config only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipes",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/r/*"]
  },
  "observability": { "enabled": true },

  // Non-secret config. GOOGLE_CLIENT_ID is the ID token audience; the Worker fails closed
  // (every sign-in refused) while it is empty. Not a secret: it is also in the browser bundle.
  // The usage-limit vars below have in-code defaults, so they stay unset until needed.
  "vars": {
    "GOOGLE_CLIENT_ID": "902211231954-phqg0e9vin17mb7ippb1niegclf8g812.apps.googleusercontent.com"
    // "MAX_TOTAL_STORAGE_BYTES": "5368709120",
    // "MAX_USER_STORAGE_BYTES": "104857600",
    // "MAX_USER_RECIPES": "50",
    // "WRITE_RATE_PER_MINUTE": "20",
    // "LINK_TITLE_RATE_PER_MINUTE": "10"
  },

  // D1 database created 11 October 2026 (region WEUR). The id is not a secret.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-recipes-db",
      "database_id": "e6303e93-052e-48f7-93b0-2fe30515abb3",
      "migrations_dir": "migrations"
    }
  ],

  // R2 bucket for uploaded files (no public bucket URL; files are served only through the
  // authenticated Worker route GET /api/recipes/:id/files/:fileId).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "family-recipes-files" }]
}
